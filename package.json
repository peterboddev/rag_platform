{
  "name": "platform-pipeline-cdk",
  "version": "1.0.0",
  "description": "Platform-owned CI/CD pipeline system using AWS CDK with TypeScript",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:utilities": "ts-node scripts/test-utilities.ts",
    "test:clean": "ts-node scripts/test-utilities.ts --clean",
    "cdk": "cdk",
    "diff": "npm run build && cdk diff",
    "diff:all": "npm run build && cdk diff '*'",
    "synth": "npm run build && cdk synth",
    "synth:all": "npm run build && cdk synth '*'",
    "deploy": "npm run build && npm run validate-config && cdk deploy",
    "deploy:all": "npm run build && npm run validate-config && cdk deploy '*'",
    "deploy:security": "npm run build && cdk deploy PlatformSecurityStack",
    "deploy:pipeline": "npm run build && cdk deploy PlatformPipelineStack",
    "bootstrap": "cdk bootstrap",
    "bootstrap:all-envs": "ts-node scripts/bootstrap-environments.ts",
    "destroy": "cdk destroy",
    "destroy:all": "cdk destroy '*'",
    "validate-config": "ts-node scripts/validate-config.ts",
    "validate-config:verbose": "ts-node scripts/validate-config.ts --verbose",
    "validate-config:fix": "ts-node scripts/validate-config.ts --fix",
    "validate-config:sample": "ts-node scripts/validate-config.ts --sample",
    "validate-configs": "ts-node scripts/validate-configs.ts",
    "validate-configs:report": "ts-node scripts/validate-configs.ts --report",
    "validate-deployment": "ts-node scripts/validate-deployment.ts",
    "validate-deployment:promotion": "ts-node scripts/validate-deployment.ts --mode promotion",
    "validate": "npm run build && npm run test && npm run validate-configs",
    "validate:full": "npm run build && npm run test:coverage && npm run validate-configs:report && npm run synth:all",
    "migrate-config": "ts-node scripts/migrate-configurations.ts",
    "migrate-config:dry-run": "ts-node scripts/migrate-configurations.ts --dry-run --verbose",
    "migrate-config:rollback": "ts-node scripts/migrate-configurations.ts --rollback",
    "local-dev": "ts-node scripts/local-dev-workflow.ts",
    "local-dev:status": "ts-node scripts/local-dev-workflow.ts --status",
    "local-dev:clean": "ts-node scripts/local-dev-workflow.ts --clean",
    "local-test": "npm run build && npm run test && npm run synth",
    "pre-commit": "ts-node scripts/pre-commit-validation.ts",
    "pre-commit:fix": "ts-node scripts/pre-commit-validation.ts --fix",
    "clean": "rimraf lib/**/*.js lib/**/*.d.ts cdk.out",
    "reset": "npm run clean && npm install && npm run build"
  },
  "devDependencies": {
    "aws-cdk": "2.1100.1",
    "rimraf": "^5.0.5"
  },
  "dependencies": {
    "aws-cdk-lib": "2.233.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@aws-sdk/client-sts": "^3.0.0",
    "typescript": "~5.2.2",
    "@types/node": "20.6.2",
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2"
  },
  "keywords": [
    "aws",
    "cdk",
    "pipeline",
    "ci-cd",
    "platform"
  ],
  "author": "Platform Team",
  "license": "MIT"
}

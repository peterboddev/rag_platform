{
  "applicationName": "rag-app",
  "environment": "dev",
  "description": "Platform-provided infrastructure resources for RAG application",
  "lastUpdated": "2026-03-09",
  "resources": {
    "dynamodb": {
      "tables": [
        {
          "tableName": "rag-app-customers-dev",
          "purpose": "Customer/tenant management",
          "primaryKey": {
            "partitionKey": "customerId",
            "type": "String"
          },
          "globalSecondaryIndexes": [
            {
              "indexName": "emailIndex",
              "partitionKey": "email",
              "type": "String",
              "purpose": "Query customers by email address"
            }
          ],
          "billingMode": "PAY_PER_REQUEST",
          "encryption": "AWS_MANAGED",
          "pointInTimeRecovery": false,
          "ssmParameterPath": "/rag-app/dev/dynamodb/customers-table-name",
          "cloudFormationExport": "rag-app-dev-customers-table"
        },
        {
          "tableName": "rag-app-documents-dev",
          "purpose": "Document metadata and processing status",
          "primaryKey": {
            "partitionKey": "documentId",
            "type": "String"
          },
          "globalSecondaryIndexes": [
            {
              "indexName": "customerIdIndex",
              "partitionKey": "customerId",
              "sortKey": "uploadedAt",
              "type": "String, Number",
              "purpose": "Query documents by customer with upload time sorting"
            },
            {
              "indexName": "statusIndex",
              "partitionKey": "status",
              "sortKey": "uploadedAt",
              "type": "String, Number",
              "purpose": "Query documents by processing status with upload time sorting"
            }
          ],
          "billingMode": "PAY_PER_REQUEST",
          "encryption": "AWS_MANAGED",
          "pointInTimeRecovery": false,
          "ssmParameterPath": "/rag-app/dev/dynamodb/documents-table-name",
          "cloudFormationExport": "rag-app-dev-documents-table"
        }
      ],
      "permissions": {
        "read": true,
        "write": true,
        "manageGSI": true,
        "deleteTable": false
      }
    },
    "cognito": {
      "userPool": {
        "name": "rag-app-users-dev",
        "purpose": "User authentication and management",
        "ssmParameterPath": "/rag-app/dev/cognito/user-pool-id",
        "cloudFormationExport": "rag-app-dev-cognito-user-pool-id"
      },
      "userPoolClient": {
        "purpose": "Application client for user authentication",
        "ssmParameterPath": "/rag-app/dev/cognito/user-pool-client-id",
        "cloudFormationExport": "rag-app-dev-cognito-client-id"
      },
      "identityPool": {
        "purpose": "Federated identity management",
        "ssmParameterPath": "/rag-app/dev/cognito/identity-pool-id",
        "cloudFormationExport": "rag-app-dev-cognito-identity-pool-id"
      }
    },
    "opensearch": {
      "collection": {
        "name": "rag-app-vectors-dev",
        "purpose": "Vector database for document embeddings",
        "type": "VECTORSEARCH",
        "ssmParameterPath": "/rag-app/dev/opensearch/collection-endpoint",
        "cloudFormationExport": "rag-app-dev-vector-db-endpoint"
      },
      "permissions": {
        "read": true,
        "write": true,
        "createIndex": true,
        "deleteIndex": true
      }
    },
    "bedrock": {
      "models": {
        "novaProModelId": "amazon.nova-pro-v1:0",
        "embeddingModelId": "amazon.titan-embed-text-v1",
        "purpose": "AI text generation and embeddings"
      },
      "permissions": {
        "invokeModel": true,
        "invokeModelWithResponseStream": true
      }
    },
    "apiGateway": {
      "restApi": {
        "name": "rag-app-api-dev",
        "purpose": "Platform-provided REST API Gateway",
        "ssmParameterPath": "/rag-app/dev/apigateway/api-id",
        "urlParameterPath": "/rag-app/dev/apigateway/api-url",
        "rootResourceIdPath": "/rag-app/dev/apigateway/root-resource-id"
      },
      "permissions": {
        "createResources": true,
        "createMethods": true,
        "createIntegrations": true,
        "deployStage": true
      }
    },
    "vpc": {
      "vpcId": {
        "purpose": "VPC for private resources",
        "ssmParameterPath": "/rag-app/dev/network/vpc-id",
        "cloudFormationExport": "rag-app-dev-vpc-id"
      },
      "privateSubnets": {
        "purpose": "Private subnets for Lambda functions",
        "ssmParameterPath": "/rag-app/dev/network/private-subnet-ids"
      },
      "securityGroups": {
        "purpose": "Security groups for Lambda functions",
        "ssmParameterPath": "/rag-app/dev/network/security-group-ids"
      }
    },
    "iam": {
      "applicationRole": {
        "name": "rag-app-rag-role-dev",
        "purpose": "IAM role for application Lambda functions with all necessary permissions",
        "ssmParameterPath": "/rag-app/dev/iam/application-role-arn",
        "cloudFormationExport": "rag-app-dev-application-role-arn",
        "permissions": [
          "Bedrock: InvokeModel, InvokeModelWithResponseStream",
          "DynamoDB: Read/Write on customers and documents tables",
          "OpenSearch: Read/Write on vector collection",
          "S3: Full access to rag-app-* buckets",
          "SQS: Full access to rag-app-* queues",
          "EventBridge: Create/manage rules for rag-app-*",
          "Step Functions: Create/manage state machines for rag-app-*",
          "Lambda: Create/invoke functions for rag-app-*",
          "Textract: DetectDocumentText, AnalyzeDocument",
          "VPC: Create/manage network interfaces",
          "CloudWatch: Logs and metrics",
          "IAM: PassRole for Lambda and Step Functions"
        ]
      }
    }
  },
  "appTeamResponsibilities": {
    "mustCreate": [
      "S3 buckets (with rag-app-* prefix)",
      "SQS queues (with rag-app-* prefix)",
      "EventBridge rules (with rag-app-* prefix)",
      "Step Functions state machines (with rag-app-* prefix)",
      "Lambda functions",
      "API Gateway resources, methods, and integrations"
    ],
    "cannotCreate": [
      "VPC or networking infrastructure",
      "Cognito user pools",
      "OpenSearch collections",
      "Bedrock Knowledge Bases",
      "DynamoDB tables (platform provides customers and documents tables)"
    ],
    "canManage": [
      "DynamoDB table data (read/write)",
      "DynamoDB GSIs (add/remove/update)",
      "API Gateway resources and methods",
      "Lambda function code and configuration"
    ]
  },
  "retrievingConfiguration": {
    "ssmParameterStore": {
      "command": "aws ssm get-parameters-by-path --path \"/rag-app/dev/\" --recursive",
      "description": "Retrieve all platform configuration parameters"
    },
    "cloudFormationExports": {
      "command": "aws cloudformation list-exports --query \"Exports[?contains(Name, 'rag-app-dev')]\"",
      "description": "List all CloudFormation exports for the application"
    },
    "individualParameter": {
      "command": "aws ssm get-parameter --name \"/rag-app/dev/dynamodb/customers-table-name\" --query 'Parameter.Value' --output text",
      "description": "Retrieve a specific configuration parameter"
    }
  },
  "deploymentStatus": {
    "deployed": true,
    "deploymentDate": "2026-03-06",
    "stacks": [
      "rag-app-network-dev",
      "rag-app-authentication-dev",
      "rag-app-vector-db-dev",
      "rag-app-data-storage-dev",
      "rag-app-api-gateway-dev",
      "rag-app-application-integration-dev"
    ],
    "verified": true
  }
}
